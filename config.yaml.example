# ============================================================
#  Personalized paper push system · example configuration
#  Copy this file to config.yaml and fill in your secrets/output settings
# ============================================================

# Fast start examples:
# py -3 main.py daily --profile multimodal --dry-run --output markdown --output html
# py -3 main.py conference --output html
# Available presets: multimodal, vision, nlp, agents

research_profile:
  directions:
    - "Multimodal Large Language Model (MLLM/VLM) reasoning and understanding"
    - "Video understanding, video question answering, video-language models"
    - "Long video understanding, long-context video models, hour-long video"
    - "LLM Agent, tool use, planning, and agentic systems"
    - "Temporal grounding, moment retrieval, video segment localization"
  keywords:
    high_priority:
      - video understanding
      - video language
      - video question
      - video QA
      - video reasoning
      - long video
      - hour-long video
      - video-llm
      - videollm
      - video agent
      - temporal grounding
      - moment retrieval
      - temporal localization
      - video grounding
      - natural language video
      - multimodal
      - multi-modal
      - vision-language
      - vision language model
      - VLM
      - MLLM
      - LMM
      - agent
      - agentic
      - tool use
      - tool-use
    medium_priority:
      - LLM
      - large language model
      - reasoning
      - grounding
      - visual grounding
      - instruction tuning
      - instruction following
      - chain-of-thought
      - hallucination
      - benchmark
      - visual understanding
      - image understanding
      - embodied

arxiv:
  categories:
    - cs.CV
    - cs.AI
    - cs.LG
    - cs.CL
    - cs.RO

huggingface:
  enabled: true
  limit: 100

llm:
  api_key: "YOUR_DEEPSEEK_API_KEY"
  api_url: "https://api.deepseek.com/v1/chat/completions"
  model: "deepseek-chat"
  score_threshold: 6
  batch_size: 10

feishu:
  webhook_url: "YOUR_FEISHU_WEBHOOK_URL"
  chat_id: ""
  app_id: ""
  app_secret: ""
  wiki_space_id: ""
  wiki_parent_node: ""

network:
  request_timeout: 30
  summary_timeout: 120

fetch:
  initial_lookback_hours: 48
  overlap_hours: 18

runtime:
  dry_run: false
  outputs:
    - feishu
    # - markdown
    # - html
    # - telegram
    # - slack

local_output:
  output_dir: output

telegram:
  bot_token: ""
  chat_id: ""

slack:
  webhook_url: ""

conference_monitor:
  enabled: true
  timeout_per_source: 8
  max_workers: 6
  venues:
    - CVPR
    - ICCV
    - WACV
    # - ICLR
    - ICML
    # - NeurIPS
    - ACL
    - NAACL
    - EMNLP
    - AAAI
    - ACMMM
